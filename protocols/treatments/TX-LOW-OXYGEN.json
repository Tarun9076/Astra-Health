{
  "id": "TX-LOW-OXYGEN",
  "version": "1.0.0",
  "title": "Low oxygen",
  "plain": "The body is not getting enough oxygen. Start oxygen, then find out why: the person or the cabin air.",
  "tier": 3,
  "priority": 1,
  "triggers": {
    "rules": [
      "RS-SPO2-CRITICAL"
    ],
    "vitals": [
      {
        "indicator": "spo2",
        "op": "lte",
        "value": 85
      }
    ]
  },
  "actFirst": true,
  "emergencyProtocol": "EMG-LOW-OXYGEN",
  "doNotGive": [
    {
      "target": "sedating_antihistamine",
      "reason": "Drowsy medicines can slow breathing"
    }
  ],
  "steps": [
    {
      "id": "stop",
      "kind": "action",
      "text": "Stop activity and sit upright."
    },
    {
      "id": "oxygen",
      "kind": "action",
      "text": "Start oxygen by the onboard checklist."
    },
    {
      "id": "call",
      "kind": "action",
      "text": "Call the crew medical officer."
    },
    {
      "id": "cabin",
      "kind": "action",
      "text": "Check the module's CO₂ and oxygen readings. If others feel unwell too, move everyone to a safe module."
    },
    {
      "id": "recheck",
      "kind": "recheck",
      "text": "Measure oxygen again",
      "afterMinutes": 5,
      "passed": "watch",
      "failed": "recheck",
      "indicator": "spo2",
      "op": "gte",
      "value": 92,
      "maxRepeats": 3,
      "failedAfterMax": "escalate",
      "emergency": "EMG-LOW-OXYGEN"
    },
    {
      "id": "watch",
      "kind": "action",
      "text": "Keep oxygen on as the checklist says and measure every 15 minutes.",
      "next": "done"
    }
  ],
  "escalation": "Oxygen still below 92% after 15 minutes on oxygen: follow EMG-LOW-OXYGEN with the CMO. Earth is informed.",
  "followUpHours": 12,
  "approval": {
    "status": "demo",
    "author": "ASTRA HEALTH team (demo)",
    "approvedBy": null,
    "date": "2026-11-16"
  }
}
