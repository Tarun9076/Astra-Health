{
  "id": "TX-LOW-OXYGEN",
  "version": "1.1.0",
  "title": "Low oxygen",
  "plain": "Your body is not getting enough oxygen. Oxygen first, then find out why.",
  "tier": 3,
  "priority": 1,
  "triggers": {
    "rules": [
      "RS-SPO2-CRITICAL"
    ],
    "vitals": [
      {
        "indicator": "spo2",
        "op": "lte",
        "value": 85
      }
    ]
  },
  "actFirst": true,
  "emergencyProtocol": "EMG-LOW-OXYGEN",
  "doNotGive": [
    {
      "target": "sedating_antihistamine",
      "reason": "Drowsy medicines can slow breathing"
    }
  ],
  "steps": [
    {
      "id": "oxygen",
      "kind": "action",
      "text": "Put on oxygen now and sit upright."
    },
    {
      "id": "cabin",
      "kind": "action",
      "text": "Look at the cabin CO₂ and oxygen readings. If they are bad, move to a safe module."
    },
    {
      "id": "recheck",
      "kind": "recheck",
      "text": "Measure your oxygen",
      "afterMinutes": 5,
      "passed": "watch",
      "failed": "recheck",
      "indicator": "spo2",
      "op": "gte",
      "value": 92,
      "maxRepeats": 3,
      "failedAfterMax": "escalate",
      "emergency": "EMG-LOW-OXYGEN"
    },
    {
      "id": "watch",
      "kind": "action",
      "text": "Keep oxygen on as the checklist says and measure every 15 minutes.",
      "next": "done"
    }
  ],
  "escalation": "Still below 92% after 15 minutes on oxygen: follow EMG-LOW-OXYGEN. The crew and Earth were alerted when you started.",
  "followUpHours": 12,
  "approval": {
    "status": "demo",
    "author": "ASTRA HEALTH team (demo)",
    "approvedBy": null,
    "date": "2026-11-16"
  }
}
