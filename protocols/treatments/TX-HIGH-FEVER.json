{
  "id": "TX-HIGH-FEVER",
  "version": "1.1.0",
  "title": "High fever",
  "plain": "Temperature 39.5 °C or more. Bring it down and check it is falling.",
  "tier": 3,
  "priority": 5,
  "triggers": {
    "rules": [
      "TH-FEVER-HIGH"
    ],
    "vitals": [
      {
        "indicator": "body_temp",
        "op": "gte",
        "value": 39.5
      }
    ]
  },
  "emergencyProtocol": "EMG-FEVER",
  "doNotGive": [],
  "steps": [
    {
      "id": "medicine",
      "kind": "medicine",
      "text": "Take a fever medicine",
      "medicines": [
        {
          "medicine": "acetaminophen"
        },
        {
          "medicine": "ibuprofen"
        }
      ]
    },
    {
      "id": "cool",
      "kind": "action",
      "text": "Take off extra layers, cool your skin with a damp cloth and drink 250 mL of water."
    },
    {
      "id": "recheck",
      "kind": "recheck",
      "text": "Measure your temperature",
      "afterMinutes": 60,
      "passed": "watch",
      "failed": "escalate",
      "indicator": "body_temp",
      "op": "lt",
      "value": 39.0
    },
    {
      "id": "watch",
      "kind": "action",
      "text": "Rest apart from the crew, keep drinking and measure every 4 hours.",
      "next": "done"
    }
  ],
  "escalation": "Still 39.0 °C or more after an hour, or confusion, a stiff neck, a rash or trouble breathing: follow EMG-FEVER. The crew and Earth were alerted when you started.",
  "followUpHours": 24,
  "approval": {
    "status": "demo",
    "author": "ASTRA HEALTH team (demo)",
    "approvedBy": null,
    "date": "2026-11-16"
  }
}
