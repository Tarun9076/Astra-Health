  "/api/astronauts/{astronaut}/measurements": {
   "get": {
    "tags": [
     "measurements"
    ],
    "summary": "Get Measurements",
    "description": "Raw readings (Valid + Questionable, with their quality) or hourly/daily buckets of Valid readings.",
    "operationId": "get_measurements_api_astronauts__astronaut__measurements_get",
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "parameters": [
     {
      "name": "astronaut",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Astronaut"
      }
     },
     {
      "name": "indicator",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "examples": [
        "resting_hr"
       ],
       "title": "Indicator"
      }
     },
     {
      "name": "start",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date-time"
        },
        {
         "type": "null"
        }
       ],
       "title": "Start"
      }
     },
     {
      "name": "end",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "date-time"
        },
        {
         "type": "null"
        }
       ],
       "title": "End"
      }
     },
     {
      "name": "bucket",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "raw",
        "hour",
        "day"
       ],
       "type": "string",
       "default": "raw",
       "title": "Bucket"
      }
     },
     {
      "name": "channel",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "Total",
          "Charged",
          "Neutron"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Channel"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SeriesOut"
