{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-SERVER.sslip.io/api/:path*" },
    { "source": "/ground-api/:path*", "destination": "https://YOUR-SERVER.sslip.io/ground-api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(index.html|sw.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
