# Copy to .env (never commit .env). Full list: docs/03-Low-Level-Design.md §18.

# --- Node identity (Habitat = onboard :8000, Ground = Earth :8001) ---
ASTRA_NODE_ROLE=Habitat
ASTRA_NODE_ID=HAB-ARES-1
ASTRA_PEER_URL=http://localhost:8001
# Habitat ↔ Ground sync (Step 9): the same random value on both nodes
ASTRA_SYNC_KEY=
ASTRA_DATABASE_URL=sqlite:///habitat.db

# --- Security ---
# Random secret for signing login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ASTRA_JWT_SECRET=

# --- AI assistant ---
# auto | claude | ollama | template
ASTRA_LLM_PROVIDER=auto
ASTRA_LLM_MODEL=claude-opus-5-5
ASTRA_OLLAMA_URL=http://localhost:11434
# Optional; without it the assistant uses its offline template answers.
ANTHROPIC_API_KEY=

# --- External data ---
# NASA API key from https://api.nasa.gov/ (free). Used for DONKI solar-storm events.
ASTRA_NASA_API_KEY=
# Microsoft Planetary Computer works without a key; a subscription key only raises rate limits.
# PC_SDK_SUBSCRIPTION_KEY=
