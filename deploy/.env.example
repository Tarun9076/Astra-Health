# Copy to deploy/.env on the server and fill in. deploy/.env is never committed (.gitignore).

# Your server's public address. Without your own domain, use sslip.io with the IP written with dashes:
# 34.93.12.7  ->  34-93-12-7.sslip.io   (HTTPS certificate is issued automatically)
ASTRA_DOMAIN=

# Random secrets: generate each with   openssl rand -hex 32
ASTRA_JWT_SECRET=
ASTRA_SYNC_KEY=

# Optional: NASA DONKI space weather (https://api.nasa.gov) and the Claude assistant.
# Empty = offline fallbacks (cached space weather, template answers).
ASTRA_NASA_API_KEY=
ANTHROPIC_API_KEY=

# Which mission day "today" is when the databases are first created (fresh demo).
ASTRA_MISSION_DAY=121
